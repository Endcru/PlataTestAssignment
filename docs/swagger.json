                    "application/json"
                ],
                "tags": [
                    "quotation"
                ],
                "summary": "Get quotation by update id",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 1,
                        "description": "Update request id",
                        "name": "update_id",
                        "in": "path",
                        "required": true
